@model IEnumerable<ExploreSV.BusinessLogic.DTOs.EventResponse>

@{
    ViewData["Title"] = "Eventos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Eventos</h2>
        <a asp-action="Create" class="btn btn-primary">Crear Evento</a>
    </div>

    <div class="card shadow-sm p-3">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Descripción</th>
                    <th>Destino Turístico</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.EventTitle</td>
                        <td>@item.EventDescription</td>
                        <td>@item.TouristDestinationTitle</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.EventId" class="btn btn-info btn-sm">Detalles</a>
                            <a asp-action="Edit" asp-route-id="@item.EventId" class="btn btn-warning btn-sm">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.EventId" class="btn btn-danger btn-sm">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
