@model ExploreSV.BusinessLogic.DTOs.CreateStatusRequest

@{
    ViewData["Title"] = "Crear Estado";
}

<link rel="stylesheet" href="~/css/Crear.css" />

<div class="container mt-5">
    <div class="custom-card">
        <h2 class="text-center text-primary mb-4">Crear Nuevo Estado</h2>
        <hr />
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="StatusName" class="form-label fw-bold">Nombre del Estado</label>
                <input asp-for="StatusName" class="form-control" placeholder="..." />
                <span asp-validation-for="StatusName" class="text-danger"></span>
            </div>
            <div class="d-flex justify-content-between mt-4">
                <button type="submit" class="btn btn-success px-4">Crear</button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}