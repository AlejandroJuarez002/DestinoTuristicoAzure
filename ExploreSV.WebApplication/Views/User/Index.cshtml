@model IEnumerable<ExploreSV.BusinessLogic.DTOs.UserResponse>

@{
    ViewData["Title"] = "Usuario";
}

<h1>Usuario</h1>

<p>
    <a asp-action="Create" class="btn btn-info">Ir a crear Usuario</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Nombre
            </th>
            <th>
                Usuario
            </th>
            <th></th>
        </tr>
    </thead>
</table>
<tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.UserName)
            </td>
            <td>
                @Html.ActionLink("Eliminar", "Delete", new { id = item.UserId}, new { @class = "btn btn-danger" })
            </td>
        </tr>
    }
</tbody>