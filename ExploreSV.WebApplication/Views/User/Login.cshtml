@model ExploreSV.BusinessLogic.UseCases.Users.Queries.GetUserAuthenticated.GetUserAuthenticatedQuery

@{
    ViewData["Title"] = "Login";
}


<link rel="stylesheet" href="~/css/Login.css" asp-append-version="true" />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Login">
            <h1>Inicio de Sesion</h1>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label class="control-label">Nombre</label>
                <input asp-for="userName" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="userPassword" class="control-label">Contraseña</label>
                <input asp-for="userPassword" type="password" class="form-control" />
            </div>
            <div class="form-group-3">
                <input type="submit" value="Iniciar Sesion" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}