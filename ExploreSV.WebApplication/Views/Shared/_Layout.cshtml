<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ExploreSV.WebApplication</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ExploreSV.WebApplication.styles.css" asp-append-version="true" />
    <style>
        html {
            position: relative;
            min-height: 100%;
        }
        
        body {
            margin-bottom: 60px;
        }
        
        .footer {
           
            position: absolute;
            bottom: 0;
            width: 100%;
            background-color: #415a77;
            padding: 20px 0;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">ExploreSV.WebApplication</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Department" asp-action="Index">Departamentos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="User" asp-action="Create">Usuarios</a>
                            </li>
                        </ul>
                        <a class="nav-link text-dark" asp-area="" asp-controller="User" asp-action="CerrarSesion">Cerrar sesion</a>
                        <span>@User.Identity.Name</span>
                    }
                    else
                    {
                        <a class="nav-link text-dark" asp-area="" asp-controller="User" asp-action="Login">Iniciar Sesion</a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @{
        var controller = ViewContext.RouteData.Values["Controller"]?.ToString();
        var action = ViewContext.RouteData.Values["Action"]?.ToString();
    }

    @if (controller == "Home" && action == "Index")
    {
        <footer class="footer">
             <div class="container">
             <div class="row">
                    <div class="col-md-4">
                        <h5>ExploreSV</h5>
                        <p>Tu mejor opcion para conocer El Salvador</p>
                    </div>
                    <div class="col-md-4">
                        <h5>Conocenos</h5>
                        <ul class="list-unstyled">
                            <li><a asp-controller="Home" asp-action="MisionVision" class="a2">Mision y Vision</a></li>
                        </ul>
                    </div>
                    <div class="col-md-4">
                        <h5>Contacto</h5>
                        <div class="contact-info">
                            <img src="~/images/arroba.png" alt="Email" class="contact-icon" />
                            <span>info@exploresv.com</span>
                        </div>
                        <div class="contact-info">
                            <img src="~/images/llamar.png" alt="Teléfono" class="contact-icon" />
                            <span>+503 7624-6958</span>
                        </div>

                    </div>

                <hr />
                   <div class="text-center footer-content">
                      <span class="copyright">&copy; @DateTime.Now.Year</span> - 
                      <span class="exploresv-white">ExploreSV</span> - 
                      <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                    </div>
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
